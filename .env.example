# Database — Supabase Postgres. Copy both from the Supabase dashboard (Connect → ORMs / Connection string).
# The app uses the transaction pooler (port 6543); migrations and `pnpm check` use the session pooler (5432).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DATABASE_DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Phone sign-in. Any phone number can sign in with this code while it is set (after asking for a code).
# Local development defaults to 123456 and shows it on screen. Deployed builds have no code unless you set
# one here — use a private one, never 123456 — and don't show it unless OTP_SHOW_CODE=on.
# Set to "off" once a real SMS provider is wired up in src/lib/sms.ts.
OTP_BYPASS_CODE=123456
# OTP_SHOW_CODE=off

# Comma-separated phone numbers that get the admin area.
ADMIN_PHONES=571-420-1217

# Optional public contact email shown on the site.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@rallyautocare.us

# Stripe — card payments, membership autopay and invoice links. Optional: without a key the app
# works as before (Zelle / Apple Pay / cash recorded by hand).
# Prefer a restricted key (rk_…) in production, stored as a sensitive environment variable.
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Signing secret of the webhook endpoint (/api/stripe/webhook). Locally: `pnpm stripe:listen` prints one.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Public address of this app, used for the page Stripe returns customers to.
# NEXT_PUBLIC_APP_URL=https://rallyautocare.us
# Sales tax. Leave off until Stripe Tax has a head office address and at least one registration,
# and your accountant has confirmed what is taxable. STRIPE_TAX_CODE is the product tax code they pick.
# STRIPE_AUTOMATIC_TAX=off
# STRIPE_TAX_CODE=

# Texts to clients (confirmations, reminders, ETAs) and sign-in codes, through Twilio. Without these,
# texts are only written to the server log. US numbers need A2P 10DLC registration before Twilio delivers.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+15715550100          # or, instead, TWILIO_MESSAGING_SERVICE_SID=MG...
# Testing with a real provider: send every text to this one number instead of the client's.
# SMS_REDIRECT_TO=+15715550100

# Protects /api/cron/reminders. Vercel Cron sends it automatically once it is set in the project.
# CRON_SECRET=
